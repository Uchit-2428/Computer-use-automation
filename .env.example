# Model access (only needed for `discover` and `ask`; replay never calls a model).
# Set ONE of these. CUA_PROVIDER=anthropic|gemini forces a choice when both are set.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# CUA_MODEL=claude-sonnet-4-5
# CUA_GEMINI_MODEL=gemini-2.5-flash

# Service-operator credentials for the *mock* CoreLink app (synthetic, demo only).
CORELINK_OPERATOR_ID=teller01
CORELINK_OPERATOR_PASSWORD=demo-pass-123

# Key for the HMAC fingerprints of financial values in persisted evidence.
CUA_EVIDENCE_KEY=change-me
